---
// Вертикальная столбчатая диаграмма (например, динамика по годам).
interface Col { label: string; value: number; display: string; hl?: boolean; gap?: boolean }
interface Props { title: string; caption?: string; cols: Col[]; height?: number }
const { title, caption, cols, height = 220 } = Astro.props;
const top = Math.max(...cols.map((c) => c.value));
---
<figure class="cc">
  <figcaption class="cc__title">{title}</figcaption>
  <div class="cc__plot" style={`--h:${height}px`}>
    {cols.map((c) => (
      <div class:list={['cc__col', { 'cc__col--hl': c.hl, 'cc__col--gap': c.gap }]}>
        <span class="cc__val">{c.display}</span>
        <div class="cc__bar" style={`height:${c.gap ? 0 : Math.max(2, (c.value / top) * 100)}%`} />
        <span class="cc__lbl">{c.label}</span>
      </div>
    ))}
  </div>
  {caption && <p class="cc__cap">{caption}</p>}
</figure>

<style>
  .cc { margin: 24px 0 28px; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-tile); }
  .cc__title { font-weight: 700; color: var(--text); font-size: 17px; margin-bottom: 18px; }
  .cc__plot { display: flex; align-items: flex-end; gap: 6px; height: calc(var(--h) + 48px); border-bottom: 1px solid var(--border); }
  .cc__col { flex: 1 1 0; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; position: relative; padding-bottom: 22px; }
  .cc__bar { width: 100%; max-width: 38px; border-radius: 6px 6px 2px 2px; background: linear-gradient(180deg, #8a6dff, #4b33c9); max-height: var(--h); }
  .cc__col--hl .cc__bar { background: linear-gradient(180deg, #f0b90b, #b26b00); box-shadow: 0 0 18px rgba(240, 185, 11, .45); }
  .cc__val { font-size: 11px; color: var(--text); margin-bottom: 4px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cc__col--gap .cc__val { color: var(--text-2); }
  .cc__lbl { position: absolute; bottom: 0; font-size: 11px; color: var(--text-2); }
  .cc__cap { margin: 14px 0 0; font-size: 13px; color: var(--text-2); }
  @media (max-width: 560px) {
    .cc { padding: 16px 12px; }
    .cc__plot { gap: 3px; }
    .cc__val { writing-mode: vertical-rl; transform: rotate(180deg); margin-bottom: 6px; }
  }
</style>
