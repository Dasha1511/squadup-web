---
interface Props { src: string; alt: string; eager?: boolean; class?: string }
const { src, alt, eager = false, class: cls } = Astro.props;
---
<figure class:list={['phone', cls]}>
  <div class="phone__screen">
    <img src={src} alt={alt} width="590" height="1278" loading={eager ? 'eager' : 'lazy'} decoding="async"
         fetchpriority={eager ? 'high' : 'auto'} />
  </div>
</figure>

<style>
  .phone {
    margin: 0; width: 100%; max-width: 300px; aspect-ratio: 590 / 1278;
    padding: 9px; border-radius: 46px; position: relative;
    background: linear-gradient(160deg, #2a3140 0%, #121720 40%, #1b2130 100%);
    box-shadow: 0 0 0 1px rgba(255,255,255,.06) inset, 0 30px 80px rgba(0,0,0,.55), 0 0 60px rgba(124,92,255,.18);
  }
  .phone__screen { width: 100%; height: 100%; border-radius: 38px; overflow: hidden; background: var(--bg); position: relative; }
  .phone__screen::before {
    content: ''; position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
    width: 30%; height: 22px; border-radius: 20px; background: #000; z-index: 2;
  }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
