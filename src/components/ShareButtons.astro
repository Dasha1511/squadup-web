---
// Кнопки «Поделиться статьёй»: «Поделиться» (системное меню, а без него — Telegram, ВКонтакте, WhatsApp) и «Скопировать ссылку».
// Сторонние скрипты не подключаются — только обычные ссылки.
import { Share2, Send, Link2, MessageCircle } from '@lucide/astro';
import { EVENTS } from '../config/site';
interface Props { url: string; title: string; compact?: boolean }
const { url, title, compact = false } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
---
<div class:list={['share', { 'share--compact': compact }]} data-share-url={url} data-share-title={title}>
  <span class="share__lbl">Поделиться статьёй</span>
  <div class="share__btns">
    <div class="share__wrap">
      <button type="button" class="share__b share__b--main" data-share-main data-track={EVENTS.share} data-track-place="share" aria-haspopup="true" aria-expanded="false"><Share2 size={18} stroke-width={1.75} /><span>Поделиться</span></button>
      <div class="share__pop" data-share-pop hidden>
        <a class="share__b share__b--tg" href={`https://t.me/share/url?url=${u}&text=${t}`} target="_blank" rel="noopener" data-track={EVENTS.share} data-track-place="telegram"><Send size={18} stroke-width={1.75} /><span>Telegram</span></a>
        <a class="share__b share__b--vk" href={`https://vk.com/share.php?url=${u}&title=${t}`} target="_blank" rel="noopener" data-track={EVENTS.share} data-track-place="vk"><b class="share__vk">VK</b><span>ВКонтакте</span></a>
        <a class="share__b share__b--wa" href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener" data-track={EVENTS.share} data-track-place="whatsapp"><MessageCircle size={18} stroke-width={1.75} /><span>WhatsApp</span></a>
      </div>
    </div>
    <button type="button" class="share__b" data-share-copy data-track={EVENTS.share} data-track-place="copy"><Link2 size={18} stroke-width={1.75} /><span data-share-copy-text>Скопировать ссылку</span></button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
    const url = box.dataset.shareUrl!;
    const title = box.dataset.shareTitle!;
    // «Поделиться»: системное меню (телефоны, Chrome/Edge/Safari); если его нет — свой список мессенджеров
    const main = box.querySelector<HTMLButtonElement>('[data-share-main]');
    const pop = box.querySelector<HTMLElement>('[data-share-pop]');
    const setPop = (open: boolean) => { if (pop) pop.hidden = !open; main?.setAttribute('aria-expanded', String(open)); };
    main?.addEventListener('click', () => {
      if (typeof navigator.share === 'function') { navigator.share({ title, url }).catch(() => {}); return; }
      setPop(pop?.hidden ?? false);
    });
    document.addEventListener('click', (e) => { if (!box.contains(e.target as Node)) setPop(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setPop(false); });
    const copy = box.querySelector<HTMLButtonElement>('[data-share-copy]');
    const label = box.querySelector<HTMLElement>('[data-share-copy-text]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea'); ta.value = url; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch { /* ничего */ }
        ta.remove();
      }
      if (label) { label.textContent = 'Ссылка скопирована'; setTimeout(() => { label.textContent = 'Скопировать ссылку'; }, 2000); }
    });
  });
</script>

<style>
  .share { margin: 24px 0; padding: 16px 18px; border-radius: var(--r-tile); background: var(--surface); border: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .share--compact { background: transparent; border: 0; padding: 0; margin: 20px 0 0; }
  .share__lbl { font-weight: 700; color: var(--text); font-size: 15px; }
  .share--compact .share__lbl { font-size: 13px; color: var(--text-2); font-weight: 600; }
  .share__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .share__b { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-2); color: var(--text) !important; font: 600 14px var(--font); text-decoration: none !important; cursor: pointer; transition: border-color .15s, background .15s; }
  .share__b:hover { border-color: #3a4352; background: #252c37; }
  .share__wrap { position: relative; }
  .share__pop { position: absolute; z-index: 20; top: calc(100% + 8px); left: 0; display: flex; flex-direction: column; gap: 6px; padding: 8px; border-radius: 16px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); min-width: 190px; }
  .share__pop[hidden] { display: none; }
  .share__pop .share__b { justify-content: flex-start; }
  .share__b--tg :global(svg) { color: #2aabee; }
  .share__b--wa :global(svg) { color: #25d366; }
  .share__vk { font-size: 12px; font-weight: 800; color: #fff; background: #0077ff; border-radius: 5px; padding: 2px 4px; line-height: 1; }
  .share__b--main { background: var(--primary-fill); border-color: var(--primary); color: #fff !important; }
  .share__b--main:hover { background: var(--primary); border-color: var(--primary); }

</style>
