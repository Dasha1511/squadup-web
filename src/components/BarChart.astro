---
// Горизонтальная столбчатая диаграмма для статей. Поддерживает одну или несколько серий:
// rows: [{ label, values: [число, …], display?: [подписи] }], legend: названия серий.
interface Row { label: string; values: number[]; display?: string[]; hl?: boolean; sub?: string }
interface Props { title: string; caption?: string; rows: Row[]; legend?: string[]; max?: number; unit?: string }
const { title, caption, rows, legend = [], max, unit = '' } = Astro.props;
const top = max ?? Math.max(...rows.flatMap((r) => r.values));
---
<figure class="bc">
  <figcaption class="bc__title">{title}</figcaption>
  {legend.length > 1 && (
    <div class="bc__legend">{legend.map((l, i) => <span><i class={`bc__dot bc__s${i}`} />{l}</span>)}</div>
  )}
  <div class="bc__rows">
    {rows.map((r) => (
      <div class:list={['bc__row', { 'bc__row--hl': r.hl }]}>
        <div class="bc__label">{r.label}{r.sub && <small>{r.sub}</small>}</div>
        <div class="bc__bars">
          {r.values.map((v, i) => (
            <div class="bc__track">
              <div class={`bc__bar bc__s${i}`} style={`width:${Math.max(2, (v / top) * 100)}%`} />
              <span class="bc__val">{r.display?.[i] ?? `${v}${unit}`}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  {caption && <p class="bc__cap">{caption}</p>}
</figure>

<style>
  .bc { margin: 24px 0 28px; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-tile); }
  .bc__title { font-weight: 700; color: var(--text); font-size: 17px; margin-bottom: 14px; }
  .bc__legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--text-2); margin-bottom: 14px; }
  .bc__legend span { display: inline-flex; align-items: center; gap: 6px; }
  .bc__dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .bc__rows { display: flex; flex-direction: column; gap: 14px; }
  .bc__row { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 14px; align-items: center; }
  .bc__label { font-size: 14px; color: #d5dae3; font-weight: 600; line-height: 1.3; }
  .bc__label small { display: block; font-weight: 400; color: var(--text-2); font-size: 12px; }
  .bc__row--hl .bc__label { color: #fff; }
  .bc__bars { display: flex; flex-direction: column; gap: 5px; }
  .bc__track { display: flex; align-items: center; gap: 8px; }
  .bc__bar { height: 18px; border-radius: 6px; transition: width .6s; }
  .bc__val { font-size: 13px; color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bc__s0 { background: linear-gradient(90deg, #6b4cf6, #9b83ff); }
  .bc__s1 { background: linear-gradient(90deg, #138fa8, #22d3ee); }
  .bc__s2 { background: linear-gradient(90deg, #b8860b, #f0b90b); }
  .bc__row--hl .bc__s0 { box-shadow: 0 0 16px rgba(124, 92, 255, .55); }
  .bc__cap { margin: 14px 0 0; font-size: 13px; color: var(--text-2); }
  @media (max-width: 560px) {
    .bc { padding: 16px; }
    .bc__row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }
</style>
