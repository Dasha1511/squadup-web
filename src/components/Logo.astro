---
import { Gamepad2 } from '@lucide/astro';
interface Props { size?: number; withText?: boolean }
const { size = 36, withText = true } = Astro.props;
---
<span class="logo">
  <span class="logo__mark" style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.29)}px`}>
    <Gamepad2 size={Math.round(size * 0.56)} stroke-width={2} aria-hidden="true" />
  </span>
  {withText && <span class="logo__text">Squadup</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__mark {
    display: grid; place-items: center; flex: none; color: #fff;
    background: linear-gradient(135deg, #7c5cff 0%, #22d3ee 100%);
    box-shadow: 0 0 18px rgba(124, 92, 255, .45);
  }
  .logo__text { font-weight: 700; font-size: 20px; letter-spacing: -0.02em; }
</style>
