---
interface Props { size?: number }
// size — высота логотипа в пикселях
const { size = 40 } = Astro.props;
const width = Math.round(size * 224 / 180);
---
<img class="logo" src="/logo.png" width={width} height={size} alt="SquadUp" decoding="async" />

<style>
  .logo { display: block; height: auto; flex: none; }
</style>
