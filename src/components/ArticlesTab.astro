---
// Плашка «Читать статьи», закреплённая у правого края экрана на главной.
import { BookOpen } from '@lucide/astro';
import { ARTICLES } from '../config/articles';
import { EVENTS } from '../config/site';
---
<a href="/articles/" class="atab" data-sq-block="articles-tab" data-track={EVENTS.articlesClick} data-track-place="side-tab" aria-label={`Читать статьи (${ARTICLES.length})`}>
  <BookOpen size={18} stroke-width={1.75} />
  <span class="atab__t">Читать статьи</span>
</a>

<style>
  .atab {
    position: fixed; right: 0; top: 50%; z-index: 40; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    padding: 16px 10px; border-radius: 14px 0 0 14px; text-decoration: none; color: #fff;
    background: linear-gradient(180deg, #7c5cff, #4b33c9); border: 1px solid rgba(255, 255, 255, .18); border-right: 0;
    box-shadow: -6px 10px 28px rgba(0, 0, 0, .45), 0 0 22px rgba(124, 92, 255, .45);
    transition: padding .2s, box-shadow .2s;
  }
  .atab:hover { padding-right: 16px; box-shadow: -6px 10px 28px rgba(0, 0, 0, .45), 0 0 32px rgba(124, 92, 255, .7); }
  .atab__t { writing-mode: vertical-rl; transform: rotate(180deg); font-weight: 700; font-size: 14px; letter-spacing: .02em; white-space: nowrap; }
  @media (max-width: 640px) {
    .atab { padding: 12px 7px; gap: 8px; }
    .atab__t { font-size: 12px; }
  }
</style>
