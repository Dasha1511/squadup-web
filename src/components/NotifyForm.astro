---
import { Send, Check } from '@lucide/astro';
import { SITE, EVENTS } from '../config/site';
interface Props { place: string; compact?: boolean }
const { place, compact = false } = Astro.props;
const uid = `nf-${place}`;
---
<div class:list={['nf', { 'nf--compact': compact }]} data-sq-block={`notify-${place}`}>
  <form class="nf__form" data-notify-form data-place={place} data-url={SITE.subscribeUrl} novalidate>
    <label for={`${uid}-email`} class="visually-hidden">Электронная почта</label>
    <div class="nf__row">
      <input id={`${uid}-email`} name="email" type="email" inputmode="email" autocomplete="email" required
             placeholder="Ваша почта" class="nf__input" maxlength="254" />
      <button type="submit" class="btn btn--primary nf__submit">Узнать о запуске</button>
    </div>
    <!-- Поле-ловушка для ботов -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="nf__trap" aria-hidden="true" />
    <label class="nf__consent">
      <input type="checkbox" name="consent" required />
      <span>Даю <a href="/consent/" target="_blank">согласие на обработку персональных данных</a>{' '}
        и ознакомлен(а) с <a href="/privacy/" target="_blank">политикой конфиденциальности</a>. Обязательно</span>
    </label>
    <label class="nf__consent">
      <input type="checkbox" name="marketing" />
      <span>Согласен(на) получать новости и рекламные рассылки SquadUp на эту почту. Можно отписаться в любой момент. Необязательно</span>
    </label>
    <p class="nf__msg" role="status" aria-live="polite"></p>
  </form>

  <div class="nf__done" hidden>
    <span class="nf__check"><Check size={20} stroke-width={2} /></span>
    <div>
      <p class="nf__done-title">Готово! Напишем, как только приложение выйдет.</p>
      <p class="muted">А пока следите за новостями в канале.</p>
    </div>
  </div>

  <a href={SITE.telegram} target="_blank" rel="noopener" class="nf__tg" data-track={EVENTS.telegram} data-track-place={place}>
    <Send size={18} stroke-width={1.5} /> Новости в Telegram — {SITE.telegramHandle}
  </a>
</div>

<script>
  import { track } from '../scripts/analytics';
  const BAD_EMAIL = 'Адрес почты введён некорректно. Проверьте его, например: name@mail.ru';
  document.querySelectorAll<HTMLFormElement>('[data-notify-form]').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.nf__msg')!;
    const btn = form.querySelector<HTMLButtonElement>('.nf__submit')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      msg.className = 'nf__msg';
      const show = (text: string, kind: 'err' | 'info' = 'err') => { msg.textContent = text; msg.classList.add(kind === 'err' ? 'is-err' : 'is-info'); };
      if (!email) { show('Введите адрес почты.'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { show(BAD_EMAIL); return; }
      if (!fd.get('consent')) { show('Отметьте согласие на обработку персональных данных — без него мы не можем сохранить почту.'); return; }
      btn.disabled = true; btn.textContent = 'Отправляем…';
      try {
        // text/plain — «простой» запрос без предварительного CORS-запроса OPTIONS
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 12000);
        const res = await fetch(form.dataset.url || '/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          signal: ctrl.signal,
          body: JSON.stringify({ email, consent: true, marketing: Boolean(fd.get('marketing')), company: fd.get('company') || '', place: form.dataset.place, page: location.pathname }),
        });
        clearTimeout(timer);
        if (!res.ok) {
          const err = String((await res.json().catch(() => ({}))).error || '');
          if (err === 'already_subscribed') { show('Эта почта уже получает уведомления.', 'info'); return; }
          if (err === 'bad_email') { show(BAD_EMAIL); return; }
          if (err === 'bad_domain') { show('Такого почтового адреса не существует. Проверьте часть после «@».'); return; }
          if (err === 'too_many_requests') { show('Слишком много попыток. Попробуйте через 10 минут.'); return; }
          throw new Error(String(res.status));
        }
        track('subscribe', { place: form.dataset.place || '' });
        form.hidden = true;
        const done = form.parentElement?.querySelector<HTMLElement>('.nf__done');
        if (done) done.hidden = false;
      } catch {
        msg.textContent = 'Не получилось отправить. Попробуйте ещё раз чуть позже или подпишитесь на Telegram-канал.';
        msg.classList.add('is-err');
      } finally {
        btn.disabled = false; btn.textContent = 'Узнать о запуске';
      }
    });
  });
</script>

<style>
  .nf { width: 100%; max-width: 560px; }
  .nf__row { display: flex; gap: 10px; }
  .nf__input {
    flex: 1; min-width: 0; height: 52px; padding: 0 16px; border-radius: var(--r-btn);
    background: var(--bg); border: 1px solid var(--border); color: var(--text); font: inherit;
    transition: border-color .15s, box-shadow .15s;
  }
  .nf__input::placeholder { color: var(--icon); }
  .nf__input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(124, 92, 255, .25); }
  .nf__trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .nf__consent { display: flex; gap: 10px; align-items: flex-start; margin-top: 12px; font-size: 13px; line-height: 18px; color: var(--text-2); cursor: pointer; }
  .nf__consent input { margin: 1px 0 0; width: 18px; height: 18px; accent-color: var(--primary); flex: none; }
  .nf__consent a { color: #b7a6ff; text-decoration: underline; text-underline-offset: 2px; }
  .nf__msg { margin: 10px 0 0; min-height: 20px; font-size: 14px; }
  .nf__msg.is-err { color: var(--error); }
  .nf__msg.is-info { color: var(--success); }
  .nf__done { display: flex; gap: 14px; align-items: flex-start; padding: 16px; border-radius: var(--r-tile); background: rgba(43, 214, 123, .08); border: 1px solid rgba(43, 214, 123, .25); }
  .nf__done[hidden] { display: none; }
  .nf__done p { margin: 0; }
  .nf__done-title { font-weight: 600; }
  .nf__check { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--success); color: #062312; flex: none; }
  .nf__tg { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 15px; font-weight: 500; color: var(--cyan); }
  .nf__tg:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 560px) {
    .nf__row { flex-direction: column; }
    .nf__submit { width: 100%; }
  }
</style>
