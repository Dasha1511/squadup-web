---
import Base from '../../layouts/Base.astro';
import BracketDiagram from '../../components/BracketDiagram.astro';
import BarChart from '../../components/BarChart.astro';
import ColumnChart from '../../components/ColumnChart.astro';
import { SITE, EVENTS } from '../../config/site';
import { ARTICLES, formatDate } from '../../config/articles';

const a = ARTICLES.find((x) => x.slug === 'kak-ustroen-kibersport')!;
const url = `${SITE.url}/articles/${a.slug}/`;

const toc = [
  ['sostav', 'Серия, карта, раунд'],
  ['bo', 'Bo1, Bo3, Bo5 и математика случайности'],
  ['draft', 'Пики, баны и вето карт'],
  ['setki', 'Турнирные сетки'],
  ['swiss', 'Швейцарская система'],
  ['posev', 'Посев, инвайты и отборочные'],
  ['primery', 'Как устроены главные турниры'],
  ['legendy', 'Истории, которые вошли в легенды'],
  ['match', 'Один день профессионального матча'],
  ['faq', 'Частые вопросы'],
];

const stats = [
  ['$40 млн', 'рекордный призовой фонд The International 2021'],
  ['6,7 млн', 'зрителей одновременно на пике финала Worlds 2025'],
  ['6', 'титулов чемпиона мира по LoL у Фейкера'],
  ['1895', 'год, когда в Цюрихе впервые сыграли по швейцарской системе'],
];

// Вероятность выиграть серию при вероятности p выиграть одну карту
const series = (p: number, need: number) => {
  let s = 0;
  const C = (n: number, k: number) => { let r = 1; for (let i = 1; i <= k; i++) r = (r * (n - k + i)) / i; return r; };
  for (let lost = 0; lost < need; lost++) s += C(need - 1 + lost, lost) * p ** need * (1 - p) ** lost;
  return Math.round(s * 1000) / 10;
};
const boRows = [['Bo1', 1], ['Bo3', 2], ['Bo5', 3], ['Bo7', 4]].map(([l, n]) => {
  const v = [series(0.6, n as number), series(0.7, n as number)];
  return { label: l as string, values: v, display: v.map((x) => `${String(x).replace('.', ',')} %`), hl: l === 'Bo5' };
});

const ti = [
  ['2011', 1.6], ['2012', 1.6], ['2013', 2.87], ['2014', 10.93], ['2015', 18.43], ['2016', 20.77], ['2017', 24.69],
  ['2018', 25.53], ['2019', 34.33], ['2020', 0], ['2021', 40.02], ['2022', 18.93], ['2023', 3.38], ['2024', 2.58], ['2025', 2.88],
].map(([y, v]) => ({
  label: `’${String(y).slice(2)}`, value: v as number, gap: v === 0, hl: y === '2021',
  display: v === 0 ? '—' : `${String(Math.round((v as number) * 10) / 10).replace('.', ',')}`,
}));

const veto = [
  ['Nuke', 'ban', 'A'], ['Train', 'ban', 'B'], ['Mirage', 'pick', 'A'], ['Inferno', 'pick', 'B'],
  ['Anubis', 'ban', 'A'], ['Ancient', 'ban', 'B'], ['Dust2', 'decider', ''],
];

const legends = [
  {
    game: 'cs', tag: 'CS:GO · 2014', title: 'Олофбуст: камбэк, от которого пришлось отказаться',
    text: 'Четвертьфинал Мейджора DreamHack Winter, fnatic против LDLC, решающая карта Overpass. LDLC ведёт 13:3 — до победы три раунда. Fnatic выигрывает 13 раундов подряд и забирает карту 16:13. Секрет оказался в баге: игрока olofmeister подсаживали на невидимый выступ, откуда он видел полкарты. Админы назначили переигровку, а fnatic под давлением сообщества снялась с турнира. Это первый в истории Мейджоров отказ от матча.',
    moral: 'Как работает протест: решение принимают судьи по регламенту, даже если карта уже «выиграна».',
  },
  {
    game: 'd2', tag: 'Dota 2 · 2015', title: 'Echo Slam за 6 миллионов долларов',
    text: 'Гранд-финал The International 2015, Evil Geniuses против CDEC. Игрок Universe на Earthshaker прыгает в толпу соперников и одной способностью Echo Slam ломает всю их атаку. Эпизод так и назвали — «Echo Slam на 6 миллионов»: столько примерно получила EG за победу на турнире.',
    moral: 'Почему финал — это Bo5: одна гениальная драка не решает всё, но может переломить серию.',
  },
  {
    game: 'd2', tag: 'Dota 2 · 2013', title: 'Хук из фонтана',
    text: 'На TI3 Na’Vi играла против Orange Esports. Dendi на Пудже бросает хук, и ровно в этот момент союзник на Чене телепортирует Пуджа на базу. Вражеский герой прилетает за ним прямо к фонтану Na’Vi — и мгновенно погибает. Связку потом повторяли тысячи игроков в пабликах, но на сцене TI она так и осталась одним из самых известных моментов.',
    moral: 'Драфт решает: необычная пара героев сама становится оружием.',
  },
  {
    game: 'cs', tag: 'CS:GO · 2020', title: 'Тренеры, которые летали над картой',
    text: 'Летом 2020 года выяснилось, что баг в режиме наблюдателя позволял тренерам видеть карту с чужих позиций или даже свободно летать над ней. Комиссия ESIC пересмотрела тысячи записей и к концу сентября отстранила 37 тренеров, а в 2022 году объявила ещё почти о сотне санкций.',
    moral: 'Зачем на LAN всё оборудование турнирное и за матчем следят админы.',
  },
  {
    game: 'cs', tag: 'CS:GO · 2021', title: 'Мейджор без единой проигранной карты',
    text: 'NAVI с s1mple выиграла PGL Major Stockholm 2021, не уступив соперникам ни одной карты за весь турнир. До этого ни одной команде такое не удавалось. А рекорд по числу Мейджоров держит Astralis: четыре титула, из них три подряд в 2018–2019 годах.',
    moral: 'Даже в Bo1 сильнейшие команды стабильно побеждают — если разница в классе огромная.',
  },
  {
    game: 'lol', tag: 'League of Legends · 2025', title: 'Шестой титул Фейкера',
    text: 'Финал Worlds 2025: T1 против KT Rolster, серия доходит до пятой карты. T1 побеждает 3:2, а Фейкер становится чемпионом мира в шестой раз — 12 лет спустя после первого титула в 2013-м. Пятую карту одновременно смотрели около 6,7 млн человек.',
    moral: 'Fearless Draft в действии: к пятой карте у обеих команд почти не осталось «любимых» чемпионов.',
  },
];

const day = [
  ['За 1–2 часа', 'Проверка оборудования', 'Игроки настраивают мышь, гарнитуру и графику на турнирных ПК'],
  ['10–15 мин', 'Драфт или вето', 'Капитаны банят и выбирают героев, чемпионов или карты'],
  ['30–60 мин', 'Карта 1', 'Тактические и технические паузы — по правилам турнира'],
  ['10–15 мин', 'Перерыв', 'Отдых, разбор с тренером, подготовка следующего драфта'],
  ['30–60 мин', 'Карта 2 и 3', 'Третья карта играется только при счёте 1:1'],
  ['После матча', 'Протокол', 'Админы фиксируют результат, команды могут подать протест'],
];

const faq = [
  ['Что значит Bo3 в киберспорте?', 'Bo3 (best of three, «лучший из трёх») — серия до двух побед. Команда, первой выигравшая две карты, выигрывает матч. Если первые две карты взяли разные команды, играется третья, решающая.'],
  ['Что такое нижняя сетка (лоуэр-брекет)?', 'Это вторая ветка в сетке double elimination. Туда попадают команды, проигравшие в верхней сетке. В нижней сетке одно поражение означает вылет, а её победитель выходит в гранд-финал против победителя верхней сетки.'],
  ['Что такое коэффициент Бухгольца?', 'Это сумма побед всех соперников команды по швейцарской системе. Он показывает, насколько сильных соперников команда уже прошла. По Бухгольцу распределяют пары в следующих раундах и места в плей-офф.'],
  ['Сколько длится матч Bo5?', 'Зависит от игры: карта в Dota 2 и League of Legends обычно идёт 30–45 минут, в CS2 — около часа. С пиками, банами и перерывами серия Bo5 занимает от 3 до 6 часов.'],
  ['Почему форматы турниров постоянно меняются?', 'Организаторы ищут баланс между справедливостью, зрелищностью и длительностью турнира: меняют число команд, переводят стадии с Bo1 на Bo3, добавляют швейцарскую систему или новые правила драфта. Поэтому правила конкретного турнира всегда проверяют в его регламенте на текущий сезон.'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.description,
    datePublished: a.published, dateModified: a.updated, inLanguage: 'ru', mainEntityOfPage: url,
    image: `${SITE.url}/og.png`,
    author: { '@type': 'Organization', name: 'SquadUp', url: SITE.url },
    publisher: { '@type': 'Organization', name: 'SquadUp', logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(([q, ans]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: ans } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${SITE.url}/articles/` },
      { '@type': 'ListItem', position: 3, name: 'Как устроен киберспорт', item: url },
    ],
  },
];
---
<Base title="Как устроен киберспорт: Bo1, Bo3, Bo5 и турнирные сетки" description={a.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="art" data-sq-block="article">
    <header class="art__head wrap">
      <nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <a href="/articles/">Статьи</a></nav>
      <div class="art__tags">{a.tags.map((t) => <span class="chip">{t}</span>)}</div>
      <h1 class="art__title">{a.title}</h1>
      <p class="lead">{a.lead}</p>
      <p class="art__meta muted">{formatDate(a.published)} · {a.readMinutes} минут чтения · Редакция SquadUp</p>
      <div class="stats">
        {stats.map(([n, t]) => <div class="stats__i"><b>{n}</b><span>{t}</span></div>)}
      </div>
    </header>

    <div class="wrap art__grid">
      <aside class="art__toc" data-sq-block="article-toc">
        <span class="caps">Содержание</span>
        <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </aside>

      <div class="prose art__body">
        <p class="hook">Вы включаете трансляцию, а там «верхняя сетка, 1:1, решающая карта, у команды ноль банов из-за Fearless». Кажется, что без словаря не разобраться. На самом деле правил немного — и после этой статьи вы будете понимать любой турнир по Dota 2, CS2 или League of Legends с первой минуты.</p>

        <div class="note" role="note">
          <strong>Форматы турниров меняются каждый сезон.</strong> Организаторы добавляют стадии, меняют число команд и переводят матчи с Bo1 на Bo3. Принципы ниже стабильны, а примеры даны на сезоны 2025–2026 годов — правила текущего турнира сверяйте с его регламентом.
        </div>

        <h2 id="sostav">Серия, карта, раунд: из чего состоит матч</h2>
        <p>Главная путаница новичков — слово «матч». Обычно это не одна игра, а целая серия. Внутри неё три уровня, как матрёшка:</p>
        <div class="nest" aria-label="Уровни матча">
          <div class="nest__l nest__l1">
            <span class="nest__k">Серия (матч)</span><span class="nest__d">несколько карт подряд, счёт вроде 2:1</span>
            <div class="nest__l nest__l2">
              <span class="nest__k">Карта (игра)</span><span class="nest__d">одна партия: 30–45 мин в Dota 2 и LoL, около часа в CS2</span>
              <div class="nest__l nest__l3">
                <span class="nest__k">Раунд</span><span class="nest__d">только в CS2: карту выигрывает тот, кто первым взял 13 раундов</span>
              </div>
            </div>
          </div>
        </div>
        <p>В Dota 2 карта заканчивается, когда разрушен Трон соперника, в LoL — Нексус. В CS2 играют до 13 раундов (формат MR12: по 12 раундов за каждую сторону), а при 12:12 начинается овертайм.</p>
        <aside class="fact"><span class="fact__k">Знали ли вы?</span> До выхода CS2 в 2023 году в Counter-Strike играли до 16 побед в раундах (MR15). С переходом на MR12 карты стали короче, а каждый раунд — дороже: права на раскачку почти не осталось.</aside>

        <h2 id="bo">Bo1, Bo3, Bo5 и математика случайности</h2>
        <p>Bo — это best of, «лучший из». Цифра показывает максимум карт в серии, а выиграть нужно больше половины.</p>
        <div class="bo">
          {[
            ['Bo1', '1 карта', 'Ранние стадии и регулярные сезоны лиг', 'Быстро, но одна ошибка решает всё'],
            ['Bo2', '2 карты', 'Групповые этапы Dota 2 с очками', 'Может закончиться ничьей 1:1'],
            ['Bo3', '2 победы из 3', 'Плей-офф почти всех турниров', 'Главный формат: есть право на ошибку'],
            ['Bo5', '3 победы из 5', 'Финалы, плей-офф Worlds по LoL', 'Проверяет выносливость и глубину пула'],
          ].map(([f, w, where, why]) => (
            <div class="bo__c">
              <div class="bo__f">{f}</div>
              <div class="bo__w">{w}</div>
              <p>{where}</p>
              <p class="bo__why">{why}</p>
            </div>
          ))}
        </div>
        <p>Зачем вообще играть длинные серии? Посчитаем. Допустим, команда A чуть сильнее и выигрывает каждую отдельную карту с вероятностью 60 %. Чем длиннее серия, тем меньше шансов у более слабой команды — в киберспорте её называют <strong>андердогом</strong> (от англ. underdog) — выиграть случайно:</p>
        <BarChart
          title="Шанс фаворита выиграть серию"
          legend={['Фаворит берёт 60 % карт', 'Явный фаворит: 70 % карт']}
          rows={boRows}
          max={100}
          caption="Расчёт по формуле биномиального распределения: каждая карта считается независимой. Bo7 в наших играх почти не встречается — он здесь для сравнения."
        />
        <p>Видно, почему финалы играют в Bo5: у сильнейшей команды больше шансов подтвердить класс, а апсет — неожиданная победа слабой команды над фаворитом — становится настоящей сенсацией, а не лотереей. И почему ранние стадии делают в Bo1: так турнир укладывается в неделю, а не в месяц.</p>

        <h2 id="draft">Пики, баны и вето карт: игра до игры</h2>
        <p>Ещё до первого выстрела команды выигрывают или проигрывают матч в драфте. Хороший драфт — это не набор самых сильных героев по отдельности, а сильнейшая <em>комбинация</em>: герои дополняют друг друга, закрывают слабости команды и ломают план соперника. Баны помогают сорвать связку, которую готовит другая сторона.</p>
        <div class="games">
          <div class="games__c games__c--d2"><b>Dota 2</b><p>Режим Captains Mode: капитаны по очереди банят и пикают героев. Каждый герой может быть только у одной команды.</p></div>
          <div class="games__c games__c--lol"><b>League of Legends</b><p>Fearless Draft: чемпиона, сыгранного в серии, нельзя взять повторно. К пятой карте привычные пики заканчиваются.</p></div>
          <div class="games__c games__c--cs"><b>CS2</b><p>Вето карт: из пула в 7 карт команды вычёркивают и выбирают поля боя, а потом стороны — атаку или защиту.</p></div>
        </div>
        <p>Вот как выглядит вето в серии Bo3 по CS2 — схема «бан, бан, пик, пик, бан, бан», последняя карта становится решающей:</p>
        <figure class="veto">
          <div class="veto__row">
            {veto.map(([m, t, who], i) => (
              <div class={`veto__m veto__m--${t}`}>
                <span class="veto__n">{i + 1}</span>
                <b>{m}</b>
                <span class="veto__t">{t === 'ban' ? `бан ${who}` : t === 'pick' ? `пик ${who}` : 'решающая'}</span>
              </div>
            ))}
          </div>
          <figcaption>Пример вето между командами A и B. Играются Mirage (выбор A), Inferno (выбор B) и при счёте 1:1 — Dust2.</figcaption>
        </figure>

        <h2 id="setki">Турнирные сетки: кто с кем и что будет после поражения</h2>
        <h3>Олимпийская система (single elimination)</h3>
        <p>Проиграл — выбыл. Самый короткий и нервный формат: одна неудачная серия может выбить фаворита. Обычно так играют плей-офф на 8 команд.</p>
        <BracketDiagram type="single" caption="Олимпийская система на 8 команд: после одного поражения команда выбывает" />

        <h3>Двойное выбывание (double elimination)</h3>
        <p>Здесь у команды две «жизни». Все стартуют в <strong>верхней сетке</strong>, а проигравший уходит в <strong>нижнюю</strong> — там поражение уже означает вылет. В гранд-финале встречаются победители обеих веток.</p>
        <BracketDiagram type="double" caption="Двойное выбывание на 4 команды: проигравший в верхней сетке получает второй шанс в нижней" />
        <aside class="fact"><span class="fact__k">Путь через нижнюю сетку</span> Зрители называют его «проходом через ад»: серий больше, усталость копится, права на ошибку нет. Team Spirit на The International 2021 прошла именно так — и обыграла PSG.LGD в финале 3:2, забрав рекордные на тот момент призовые.</aside>

        <h3>Круговая система (round robin)</h3>
        <p>Каждый играет с каждым, места решает таблица. Максимально честно, но долго: число матчей растёт почти как квадрат числа команд. Поэтому круговую систему оставляют для групп и регулярных сезонов лиг.</p>
        <BarChart
          title="Сколько матчей нужно сыграть, если на турнире 16 команд"
          rows={[
            { label: 'Олимпийская', values: [15], display: ['15 матчей'] },
            { label: 'Двойное выбывание', values: [30], display: ['30 матчей'] },
            { label: 'Швейцарская', sub: 'только отбор 8 из 16', values: [33], display: ['33 матча'] },
            { label: 'Круговая', values: [120], display: ['120 матчей'], hl: true },
          ]}
          caption="Для двойного выбывания — без «перезапуска» гранд-финала. Швейцарская система определяет не чемпиона, а восьмёрку для плей-офф."
        />

        <h3>Группы GSL</h3>
        <p>Мини-сетка двойного выбывания на 4 команды, названная в честь корейской лиги GSL по StarCraft II. Победители стартовых матчей играют «матч победителей», проигравшие — «матч на вылет», а затем идёт решающая игра. Из группы выходят двое, и каждая команда гарантированно играет минимум две серии.</p>

        <h2 id="swiss">Швейцарская система: как пришла из шахмат и захватила киберспорт</h2>
        <p>Первый турнир по этой системе сыграли шахматисты в Цюрихе в 1895 году — отсюда и название. Сегодня это главный формат групповых стадий на Мейджорах по CS2, The International и Worlds.</p>
        <p>Правило простое: в каждом раунде играют команды с одинаковым счётом — 1–0 против 1–0, 0–1 против 0–1. Три победы — проход дальше, три поражения — вылет. Максимум пять раундов.</p>
        <BracketDiagram type="swiss" caption="Швейцарская система на 16 команд: 3 победы — выход в плей-офф, 3 поражения — вылет" />
        <p>Чтобы пары были честными, используют <strong>коэффициент Бухгольца</strong> — сумму побед всех ваших соперников. Если у двух команд по 2–1, но одна обыграла сильных, а другая слабых, у первой Бухгольц выше: ей достанется соперник послабее и посев повыше. Матчи на выход и вылет обычно играют в Bo3, а остальные — в Bo1.</p>

        <h2 id="posev">Посев, инвайты и отборочные</h2>
        <p><strong>Посев</strong> разводит фаворитов по разным частям сетки, чтобы они не встретились в первом же раунде. Его берут из рейтингов или результатов прошлых стадий.</p>
        <p>На большой турнир попадают двумя путями. <strong>Инвайт</strong> (прямое приглашение) получают лидеры рейтингов — в CS2, например, места на Мейджоры раздают по региональному рейтингу Valve. Все остальные идут через <strong>отборочные</strong>: открытые онлайн-квалификации, где любая команда, даже собранная из незнакомцев, может пробиться на сцену.</p>

        <h2 id="primery">Как устроены главные турниры прямо сейчас</h2>
        <div class="tours">
          <div class="tour tour--d2">
            <span class="tour__g">Dota 2</span>
            <b class="tour__n">The International 2025</b>
            <span class="tour__p">Гамбург</span>
            <ol class="tour__s">
              <li><em>Группы</em> 16 команд, швейцарская система, все матчи Bo3</li>
              <li><em>Плей-офф</em> 8 команд, двойное выбывание, Bo3</li>
              <li><em>Финал</em> Bo5: Team Falcons — Xtreme Gaming 3:2</li>
            </ol>
          </div>
          <div class="tour tour--cs">
            <span class="tour__g">CS2</span>
            <b class="tour__n">IEM Cologne Major 2026</b>
            <span class="tour__p">Кёльн</span>
            <ol class="tour__s">
              <li><em>Группы</em> 32 команды, три швейцарских стадии; на третьей впервые все матчи Bo3</li>
              <li><em>Плей-офф</em> 8 команд, олимпийская система, Bo3</li>
              <li><em>Финал</em> Bo5</li>
            </ol>
          </div>
          <div class="tour tour--lol">
            <span class="tour__g">League of Legends</span>
            <b class="tour__n">Worlds 2025</b>
            <span class="tour__p">Китай</span>
            <ol class="tour__s">
              <li><em>Группы</em> швейцарская стадия на 16 команд, решающие матчи Bo3 с Fearless Draft</li>
              <li><em>Плей-офф</em> 8 команд, олимпийская система, все матчи Bo5</li>
              <li><em>Финал</em> T1 — KT Rolster 3:2</li>
            </ol>
          </div>
        </div>
        <p>Общий тренд хорошо виден: группы переходят на швейцарскую систему, а важные матчи — в Bo3 и Bo5, чтобы меньше решал случай.</p>
        <p>А вот деньги в киберспорте ведут себя куда менее предсказуемо. Призовой фонд The International годами пополняли сами игроки: четверть выручки от боевого пропуска уходила в призовые. Когда Valve отказалась от этой схемы, фонд упал в десять раз.</p>
        <ColumnChart
          title="Призовой фонд The International, млн долларов"
          cols={ti}
          caption="В 2020 году турнир не проводился. Рекорд — 40 млн долларов в 2021 году. С 2023 года фонд больше не пополняется из продаж боевого пропуска."
        />

        <h2 id="legendy">Истории, которые вошли в легенды</h2>
        <p>Правила турниров во многом писались после громких случаев. Вот шесть историй, которые знает каждый фанат — и чему они научили организаторов.</p>
        <div class="leg">
          {legends.map((l) => (
            <div class={`leg__c leg__c--${l.game}`}>
              <span class="leg__tag">{l.tag}</span>
              <h3 class="leg__t">{l.title}</h3>
              <p>{l.text}</p>
              <p class="leg__m"><span>Что это объясняет:</span> {l.moral}</p>
            </div>
          ))}
        </div>

        <h2 id="match">Один день профессионального матча</h2>
        <p>Отборочные часто играют онлайн, а финальные стадии — на LAN: команды сидят в одном зале за одинаковыми турнирными компьютерами. Так нет задержек сети и меньше возможностей для нечестной игры. Вот как выглядит типичная серия Bo3:</p>
        <ol class="tl">
          {day.map(([t, h, d]) => (
            <li class="tl__i"><span class="tl__time">{t}</span><b>{h}</b><span class="tl__d">{d}</span></li>
          ))}
        </ol>
        <p>В CS2 командам разрешены тактические паузы, в Dota 2 и LoL — технические при сбоях. В LoL игру можно даже «откатить» к моменту до поломки: для этого есть специальный режим Chronobreak.</p>

        <div class="cta-box">
          <h2>Соберите свою команду и сыграйте турнир</h2>
          <p>Всё это работает и в любительских турнирах. В <a href="/features/">SquadUp</a> организатор выбирает сетку — олимпийскую, двойное выбывание или круговую — и проводит турнир по Dota 2, CS2 или League of Legends. А если не хватает игроков, приложение подберёт тиммейтов по роли и рангу.</p>
          <div class="art__cta">
            <a href="/download/" class="btn btn--primary" data-track={EVENTS.notifyClick} data-track-place="article">Узнать о запуске</a>
            <a href={SITE.telegram} class="btn btn--ghost" target="_blank" rel="noopener" data-track={EVENTS.telegram} data-track-place="article">Новости в Telegram</a>
          </div>
        </div>

        <h2 id="faq">Частые вопросы</h2>
        <div class="art__faq">
          {faq.map(([q, ans]) => (
            <details class="art__q"><summary>{q}</summary><p>{ans}</p></details>
          ))}
        </div>
      </div>
    </div>
  </article>
</Base>

