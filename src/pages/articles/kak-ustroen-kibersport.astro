---
import Base from '../../layouts/Base.astro';
import BracketDiagram from '../../components/BracketDiagram.astro';
import { SITE, EVENTS } from '../../config/site';
import { ARTICLES, formatDate } from '../../config/articles';

const a = ARTICLES.find((x) => x.slug === 'kak-ustroen-kibersport')!;
const url = `${SITE.url}/articles/${a.slug}/`;

const toc = [
  ['sostav', 'Из чего состоит матч: раунд, карта, серия'],
  ['bo', 'Bo1, Bo2, Bo3, Bo5: что значат форматы матчей'],
  ['draft', 'Пики, баны и выбор карт перед матчем'],
  ['setki', 'Турнирные сетки: олимпийская, двойная, круговая'],
  ['swiss', 'Швейцарская система и коэффициент Бухгольца'],
  ['gsl', 'Группы GSL'],
  ['posev', 'Посев, инвайты и отборочные'],
  ['primery', 'Как устроены крупнейшие турниры сейчас'],
  ['match', 'Как проходит профессиональный матч'],
  ['faq', 'Частые вопросы'],
];

const faq = [
  ['Что значит Bo3 в киберспорте?', 'Bo3 (best of three, «лучший из трёх») — серия до двух побед. Команда, первой выигравшая две карты, выигрывает матч. Если первые две карты взяли разные команды, играется третья, решающая.'],
  ['Что такое нижняя сетка (лоуэр-брекет)?', 'Это вторая ветка в сетке double elimination. Туда попадают команды, проигравшие в верхней сетке. В нижней сетке одно поражение означает вылет, а её победитель выходит в гранд-финал против победителя верхней сетки.'],
  ['Что такое коэффициент Бухгольца?', 'Это сумма побед всех соперников команды по швейцарской системе. Он показывает, насколько сильных соперников команда уже прошла. По Бухгольцу распределяют пары в следующих раундах и места в плей-офф.'],
  ['Сколько длится матч Bo5?', 'Зависит от игры: карта в Dota 2 и League of Legends обычно идёт 30–45 минут, в CS2 — около часа. С пиками, банами и перерывами серия Bo5 занимает от 3 до 6 часов.'],
  ['Почему форматы турниров постоянно меняются?', 'Организаторы ищут баланс между справедливостью, зрелищностью и длительностью турнира: меняют число команд, переводят стадии с Bo1 на Bo3, добавляют швейцарскую систему или новые правила драфта. Поэтому правила конкретного турнира всегда проверяют в его регламенте на текущий сезон.'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.description,
    datePublished: a.published, dateModified: a.updated, inLanguage: 'ru', mainEntityOfPage: url,
    image: `${SITE.url}/og.png`,
    author: { '@type': 'Organization', name: 'SquadUp', url: SITE.url },
    publisher: { '@type': 'Organization', name: 'SquadUp', logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(([q, ans]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: ans } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${SITE.url}/articles/` },
      { '@type': 'ListItem', position: 3, name: 'Как устроен киберспорт', item: url },
    ],
  },
];
---
<Base title="Как устроен киберспорт: Bo1, Bo3, Bo5 и турнирные сетки" description={a.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="art" data-sq-block="article">
    <header class="art__head wrap">
      <nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <a href="/articles/">Статьи</a></nav>
      <div class="art__tags">{a.tags.map((t) => <span class="chip">{t}</span>)}</div>
      <h1 class="art__title">{a.title}</h1>
      <p class="lead">{a.lead}</p>
      <p class="art__meta muted">{formatDate(a.published)} · {a.readMinutes} минут чтения · Редакция SquadUp</p>
    </header>

    <div class="wrap art__grid">
      <aside class="art__toc" data-sq-block="article-toc">
        <span class="caps">Содержание</span>
        <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </aside>

      <div class="prose art__body">
        <div class="note" role="note">
          <strong>Важно:</strong> форматы турниров меняются каждый сезон. Организаторы добавляют стадии, меняют число команд и переводят матчи с Bo1 на Bo3. Общие принципы в статье стабильны, а конкретные примеры приведены на сезоны 2025–2026 годов. Правила текущего турнира всегда сверяйте с его официальным регламентом.
        </div>

        <h2 id="sostav">Из чего состоит матч: раунд, карта, серия</h2>
        <p>В киберспорте слово «матч» часто означает не одну игру, а серию игр между двумя командами. Чтобы понимать трансляции, нужно различать три уровня.</p>
        <ul>
          <li><strong>Карта (игра, map)</strong> — одна завершённая партия. В Dota 2 и League of Legends карта заканчивается, когда разрушено главное здание соперника: Трон в Dota 2 или Нексус в LoL. Карта обычно идёт 30–45 минут.</li>
          <li><strong>Раунд</strong> — единица внутри карты в CS2. Карта CS2 играется до 13 выигранных раундов (формат MR12: 12 раундов за каждую сторону). При счёте 12:12 начинается овертайм — дополнительные раунды, пока одна из команд не вырвется вперёд.</li>
          <li><strong>Серия (матч)</strong> — несколько карт подряд между теми же командами. Сколько карт нужно выиграть, задаёт формат Bo.</li>
        </ul>
        <p>Поэтому счёт «2:1» на турнире по Dota 2 означает, что команда выиграла две карты из трёх, а «13:9» в CS2 — что она выиграла одну карту со счётом по раундам 13:9.</p>

        <h2 id="bo">Bo1, Bo2, Bo3, Bo5: что значат форматы матчей</h2>
        <p>Bo — сокращение от английского best of, «лучший из». Цифра показывает максимальное число карт в серии. Чтобы выиграть, нужно взять больше половины карт.</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Формат</th><th>Нужно побед</th><th>Где встречается</th><th>Особенности</th></tr></thead>
            <tbody>
              <tr><td><strong>Bo1</strong></td><td>1 карта</td><td>Ранние стадии и групповые этапы с большим числом команд, регулярные сезоны лиг</td><td>Быстро, но много случайности: одна ошибка решает судьбу матча</td></tr>
              <tr><td><strong>Bo2</strong></td><td>2 карты, возможна ничья 1:1</td><td>Групповые этапы в Dota 2, где считают очки</td><td>Победа 2:0 даёт больше очков, ничья делит их поровну</td></tr>
              <tr><td><strong>Bo3</strong></td><td>2 карты из 3</td><td>Плей-офф и решающие матчи почти всех турниров</td><td>Основной формат: даёт право на ошибку и проверяет глубину пула героев или карт</td></tr>
              <tr><td><strong>Bo5</strong></td><td>3 карты из 5</td><td>Финалы и гранд-финалы, плей-офф чемпионата мира по LoL</td><td>Самый честный и самый долгий формат: проверяет выносливость и умение перестраиваться</td></tr>
            </tbody>
          </table>
        </div>
        <p>Чем выше ставки, тем длиннее серия. На одном турнире легко увидеть все форматы сразу: групповой этап в Bo1 или Bo3, плей-офф в Bo3 и гранд-финал в Bo5.</p>

        <h2 id="draft">Пики, баны и выбор карт перед матчем</h2>
        <p>Ещё до начала карты команды борются за преимущество. Это называется драфтом (в Dota 2 и LoL) или вето карт (в CS2).</p>
        <p><strong>Dota 2.</strong> В профессиональных матчах используется режим Captains Mode. Капитаны по очереди запрещают (банят) и выбирают (пикают) героев. Каждый герой может быть только у одной команды, поэтому драфт — отдельная стратегическая игра: можно забрать сильного героя себе или просто не дать его сопернику.</p>
        <p><strong>League of Legends.</strong> Команды по очереди банят и выбирают чемпионов. В последних сезонах на крупных турнирах применяют <em>Fearless Draft</em>: чемпиона, которого команда уже сыграла в этой серии, нельзя выбрать на следующих картах. Поэтому в длинной серии Bo5 к последним картам у команд заканчиваются привычные чемпионы и растёт роль глубины пула.</p>
        <p><strong>CS2.</strong> Вместо героев выбирают карты из соревновательного пула (Active Duty), обычно это 7 карт. В серии Bo3 команды по очереди вычёркивают и выбирают карты по схеме «бан — бан — пик — пик — бан — бан». Оставшаяся седьмая карта становится решающей, если счёт будет 1:1. Затем команды выбирают стороны: атаку или защиту.</p>

        <h2 id="setki">Турнирные сетки: олимпийская, двойная, круговая</h2>
        <p>Сетка (bracket) определяет, кто с кем играет и что происходит после поражения. Основных вариантов четыре.</p>

        <h3>Олимпийская система (single elimination)</h3>
        <p>Проиграл — выбыл. Команды проходят четвертьфиналы, полуфиналы и финал. Это самый короткий и зрелищный формат, но одна неудачная серия может выбить сильную команду. Обычно его используют в плей-офф, когда в нём остаётся 8 команд.</p>
        <BracketDiagram type="single" caption="Олимпийская система на 8 команд: после одного поражения команда выбывает" />

        <h3>Двойное выбывание (double elimination)</h3>
        <p>Сетка состоит из двух веток. Все начинают в <strong>верхней сетке</strong> (upper bracket). Проигравший не вылетает, а уходит в <strong>нижнюю сетку</strong> (lower bracket) и получает второй шанс. В нижней сетке поражение уже означает вылет. В гранд-финале встречаются победитель верхней сетки и победитель нижней.</p>
        <p>Победитель нижней сетки проходит более длинный путь и играет больше серий, поэтому зрители часто называют его «проходом через ад». На некоторых турнирах команде из верхней сетки дают преимущество в гранд-финале, например фору в одну карту, но это правило встречается всё реже.</p>
        <BracketDiagram type="double" caption="Двойное выбывание на 4 команды: проигравший в верхней сетке получает второй шанс в нижней" />

        <h3>Круговая система (round robin)</h3>
        <p>Каждая команда играет с каждой, за победы начисляются очки, места определяются по таблице. Формат самый справедливый, но долгий: для 8 команд нужно сыграть 28 матчей. Поэтому его используют в групповых этапах и регулярных сезонах лиг, например в региональных лигах по League of Legends.</p>

        <h2 id="swiss">Швейцарская система и коэффициент Бухгольца</h2>
        <p>Швейцарская система пришла из шахмат и сегодня стала главным форматом групповых стадий на крупнейших турнирах. Команды не играют каждая с каждой. В каждом раунде соперников подбирают среди команд с таким же счётом: 1–0 играет с 1–0, 0–1 — с 0–1.</p>
        <ul>
          <li>Команда, набравшая <strong>3 победы</strong>, проходит дальше.</li>
          <li>Команда, набравшая <strong>3 поражения</strong>, выбывает.</li>
          <li>Стадия длится не больше пяти раундов. Из 16 команд дальше проходят 8.</li>
        </ul>
        <BracketDiagram type="swiss" caption="Швейцарская система на 16 команд: 3 победы — выход в плей-офф, 3 поражения — вылет" />
        <p>Чтобы пары в следующих раундах были справедливыми, используют <strong>коэффициент Бухгольца</strong> — сумму побед всех соперников команды. Если у двух команд счёт 2–1, но одна обыграла сильных соперников, а другая слабых, у первой Бухгольц выше. Её сведут с более слабым соперником, а в плей-офф она получит посев выше.</p>
        <p>Матчи, где решается выход или вылет (при счёте 2–2, а иногда и 2–0 или 0–2), часто играют в Bo3, а остальные — в Bo1. Так турнир не растягивается, но судьбу команды не решает одна карта.</p>

        <h2 id="gsl">Группы GSL</h2>
        <p>Формат назван в честь корейской лиги GSL по StarCraft II. В группе 4 команды, внутри неё работает двойное выбывание. Две пары играют стартовые матчи. Победители встречаются в «матче победителей», а проигравшие — в «матче на выбывание». Затем проводится решающий матч. В итоге из группы выходят две команды, а каждая команда играет не меньше двух серий. Формат часто встречается на турнирах среднего уровня.</p>

        <h2 id="posev">Посев, инвайты и отборочные</h2>
        <p><strong>Посев (seeding)</strong> — распределение команд по сетке с учётом их силы, чтобы фавориты не встретились уже в первом раунде. Посев берут из рейтингов, результатов прошлых стадий или того же коэффициента Бухгольца.</p>
        <p>На турнир попадают двумя путями. <strong>Прямое приглашение (инвайт)</strong> получают сильнейшие команды по рейтингу: например, в CS2 приглашения на Мейджоры раздают по региональному рейтингу Valve (Valve Regional Standings). <strong>Отборочные (квалификации)</strong> проходят все остальные. Обычно это открытые онлайн-турниры, где любая команда, в том числе любительская, может пробиться на большую сцену.</p>

        <h2 id="primery">Как устроены крупнейшие турниры сейчас</h2>
        <p>Для понимания общей картины — три главных турнира по нашим играм. Это форматы конкретных сезонов: в следующем году они могут измениться.</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Турнир</th><th>Групповой этап</th><th>Плей-офф</th><th>Финал</th></tr></thead>
            <tbody>
              <tr><td><strong>The International 2025</strong> (Dota 2, Гамбург)</td><td>16 команд, швейцарская система, все матчи Bo3, затем раунд на выбывание</td><td>8 команд, двойное выбывание, Bo3</td><td>Bo5</td></tr>
              <tr><td><strong>IEM Cologne Major 2026</strong> (CS2, Кёльн)</td><td>32 команды, три швейцарских стадии по 16 команд; на первых двух — Bo1, решающие матчи — Bo3; на третьей впервые все матчи Bo3</td><td>8 команд, олимпийская система, Bo3</td><td>Bo5</td></tr>
              <tr><td><strong>Worlds 2025</strong> (League of Legends, Китай)</td><td>Отборочный матч Bo5, затем швейцарская стадия на 16 команд: обычные матчи — Bo1, решающие — Bo3 с Fearless Draft</td><td>8 команд, олимпийская система, все матчи Bo5</td><td>Bo5, победила T1 (3:2 против KT Rolster)</td></tr>
            </tbody>
          </table>
        </div>
        <p>Видно общее направление: групповые стадии всё чаще проводят по швейцарской системе, а ключевые матчи переводят в Bo3 и Bo5, чтобы снизить роль случайности.</p>

        <h2 id="match">Как проходит профессиональный матч</h2>
        <ol>
          <li><strong>Подготовка.</strong> Команды изучают записи игр соперника и готовят драфты или карты. У топовых команд этим занимаются тренер и аналитик.</li>
          <li><strong>LAN или онлайн.</strong> Отборочные часто играют онлайн, а финальные стадии — на LAN: команды сидят в одном зале на одинаковых компьютерах турнира. Это убирает задержки сети и снижает риск нечестной игры.</li>
          <li><strong>Технические проверки.</strong> Перед картой проверяют оборудование, связь и настройки. За порядком следят судьи (админы турнира).</li>
          <li><strong>Драфт или вето.</strong> Команды выбирают героев, чемпионов или карты по правилам формата.</li>
          <li><strong>Игра.</strong> В CS2 командам разрешены тактические паузы. В Dota 2 и LoL при сбое можно взять техническую паузу, а в LoL игру даже могут перезапустить с сохранённого момента.</li>
          <li><strong>Перерывы между картами</strong> — обычно 10–15 минут на отдых и подготовку к следующему драфту.</li>
          <li><strong>Протест и пересчёт.</strong> Если произошла ошибка или нарушение, команда может подать протест. Решение принимают судьи по регламенту турнира.</li>
        </ol>

        <h2>Попробуйте сами: турниры в SquadUp</h2>
        <p>Всё описанное работает и в любительских турнирах. В <a href="/features/">SquadUp</a> организатор выбирает формат сетки — олимпийскую систему, двойное выбывание или круговую — и проводит турнир по Dota 2, CS2 или League of Legends. Команды регистрируются, отмечают готовность к матчу и вносят результаты.</p>
        <p>Нет полного состава? В приложении можно найти тиммейтов по роли и рангу и собрать команду из пяти основных игроков и до двух запасных.</p>
        <div class="art__cta">
          <a href="/download/" class="btn btn--primary" data-track={EVENTS.notifyClick} data-track-place="article">Узнать о запуске</a>
          <a href={SITE.telegram} class="btn btn--ghost" target="_blank" rel="noopener" data-track={EVENTS.telegram} data-track-place="article">Новости в Telegram</a>
        </div>

        <h2 id="faq">Частые вопросы</h2>
        <div class="art__faq">
          {faq.map(([q, ans]) => (
            <details class="art__q"><summary>{q}</summary><p>{ans}</p></details>
          ))}
        </div>

        <h2>Источники</h2>
        <ul class="art__src">
          <li><a href="https://en.wikipedia.org/wiki/The_International_2025" target="_blank" rel="noopener">The International 2025 — Wikipedia</a></li>
          <li><a href="https://en.wikipedia.org/wiki/IEM_Cologne_Major_2026" target="_blank" rel="noopener">IEM Cologne Major 2026 — Wikipedia</a></li>
          <li><a href="https://liquipedia.net/leagueoflegends/Worlds_2025" target="_blank" rel="noopener">Worlds 2025 — Liquipedia</a></li>
          <li><a href="https://liquipedia.net/leagueoflegends/World_Championship/2025/Swiss_Stage" target="_blank" rel="noopener">2025 World Championship: Swiss Stage — Liquipedia</a></li>
        </ul>
      </div>
    </div>
  </article>
</Base>

<style>
  .art__head { padding-top: 48px; padding-bottom: 12px; max-width: 900px; }
  .crumbs { font-size: 14px; color: var(--text-2); }
