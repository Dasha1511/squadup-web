---
import { Users, Shield, Trophy, Coins, ArrowRight, ShieldCheck, BarChart3, Wallet } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StoreButtons from '../components/StoreButtons.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqList from '../components/FaqList.astro';
import { GAMES } from '../config/games';
import { EVENTS } from '../config/site';

const features = [
  { icon: Users, tone: '', title: 'Поиск тиммейтов', text: 'Свайпай карточки игроков с рангом, ролью и статистикой. Взаимный лайк — и вы видите контакты друг друга.' },
  { icon: Shield, tone: 'icon-tile--cyan', title: 'Команды', text: 'Собери состав под турнир: приглашения по ссылке, заявки, запасные и открытые роли.' },
  { icon: Trophy, tone: 'icon-tile--gold', title: 'Турниры', text: 'Организуй свой турнир за 4 шага: сетка SE, DE или Round Robin, чек-ин и результаты матчей.' },
  { icon: Coins, tone: 'icon-tile--green', title: 'Призы', text: 'Призовой фонд в рублях делится 60/30/10 и выплачивается через СБП или на карту.' },
];

const screens = [
  { src: '/screens/feed.webp', title: 'Лента игроков', text: 'Карточка с рангом, винрейтом и мейнами' },
  { src: '/screens/match.webp', title: 'Мэтч', text: 'Взаимный лайк открывает ник и контакты' },
  { src: '/screens/tournaments.webp', title: 'Турниры', text: 'Фильтр по игре и открытой регистрации' },
  { src: '/screens/tournament.webp', title: 'Карточка турнира', text: 'Формат, ранги, призы и сетка' },
  { src: '/screens/profile.webp', title: 'Профиль', text: 'Статистика по каждой игре' },
  { src: '/screens/results.webp', title: 'Итоги', text: 'Места и распределение фонда' },
];

const steps = [
  { n: '01', title: 'Привяжи игры', text: 'Укажи Steam ID или Riot ID — ранг и статистика подтянутся сами.' },
  { n: '02', title: 'Найди своих', text: 'Свайпай игроков по роли, рангу и времени игры. Мэтч — и можно договариваться.' },
  { n: '03', title: 'Собери команду', text: 'Пригласи тиммейтов в состав или вступи в команду, которой нужна твоя роль.' },
  { n: '04', title: 'Играй на призы', text: 'Регистрируйся в турнир, проходи сетку и забирай свою долю фонда.' },
];
---
<Base>
  <!-- ГЛАВНЫЙ ЭКРАН -->
  <section class="hero" data-sq-block="hero">
    <div class="glow-bg"></div>
    <div class="grid-lines"></div>
    <div class="wrap hero__in rel">
      <div class="hero__copy">
        <span class="chip hero__badge"><span class="dot" style="background:var(--success)"></span>Скоро в Google Play и App Store</span>
        <h1 class="h1">Найди тиммейтов.<br /><span class="grad-text">Выиграй турнир.</span></h1>
        <p class="lead">Squadup — приложение для поиска игроков, сбора команд и турниров с призовым фондом по Dota&nbsp;2, League of Legends и CS2.</p>
        <div class="hero__actions">
          <a href="#notify" class="btn btn--primary" data-track={EVENTS.notifyClick} data-track-place="hero">Узнать о запуске</a>
          <a href="#how" class="btn btn--ghost">Как это работает</a>
        </div>
        <div class="hero__games">
          {GAMES.map((g) => <span class="chip"><span class="dot" style={`background:${g.tone}`}></span>{g.name}</span>)}
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__phone hero__phone--back"><PhoneFrame src="/screens/tournaments.webp" alt="" /></div>
        <div class="hero__phone hero__phone--front"><PhoneFrame src="/screens/feed.webp" alt="" eager /></div>
        <div class="hero__float hero__float--a"><span class="caps" style="color:var(--text-2)">Мэтч</span><b>NV ✕ KM</b></div>
        <div class="hero__float hero__float--b"><span class="caps" style="color:var(--text-2)">Призовой фонд</span><b>10 000 ₽</b></div>
      </div>
    </div>
  </section>

  <!-- ВОЗМОЖНОСТИ -->
  <section class="section" id="features" data-sq-block="features">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="caps">Возможности</span>
        <h2 class="h2">Всё, чтобы играть не в соло</h2>
        <p class="lead">От поиска одного тиммейта до своего турнира на 16 команд — в одном приложении.</p>
      </div>
      <div class="grid-4">
        {features.map((f) => (
          <article class="card feat reveal">
            <div class:list={['icon-tile', f.tone]}><f.icon size={24} stroke-width={1.5} /></div>
            <h3 class="h3">{f.title}</h3>
            <p class="muted">{f.text}</p>
          </article>
        ))}
      </div>
      <a href="/features/" class="more reveal">Подробнее о возможностях <ArrowRight size={18} stroke-width={1.5} /></a>
    </div>
  </section>

  <!-- СКРИНШОТЫ -->
  <section class="section section--tight screens" id="screens" data-sq-block="screens">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="caps">Приложение</span>
        <h2 class="h2">Так выглядит Squadup</h2>
      </div>
    </div>
    <div class="screens__track" tabindex="0" aria-label="Скриншоты приложения">
      {screens.map((s, i) => (
        <figure class="screens__item">
          <PhoneFrame src={s.src} alt={`Экран приложения Squadup: ${s.title}`} eager={i < 4} />
          <figcaption><b>{s.title}</b><span class="muted">{s.text}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="section" id="how" data-sq-block="how">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="caps">Как это работает</span>
        <h2 class="h2">Четыре шага до первого турнира</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step reveal">
            <span class="step__n">{s.n}</span>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <a href="/how-it-works/" class="more reveal">Сценарий целиком <ArrowRight size={18} stroke-width={1.5} /></a>
    </div>
  </section>

  <!-- ИГРЫ -->
  <section class="section section--tight" id="games" data-sq-block="games">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="caps">Поддерживаемые игры</span>
        <h2 class="h2">Три дисциплины на старте</h2>
      </div>
      <div class="grid-3">
        {GAMES.map((g) => (
          <a href={`/games/#${g.slug}`} class="game reveal" style={`--from:${g.from};--to:${g.to};--tone:${g.tone}`} data-sq-block={`game-${g.slug}`}>
            <span class="game__code">{g.code}</span>
            <span class="game__name">{g.name}</span>
            <span class="game__meta">{g.format} · {g.account}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ДОВЕРИЕ / ПРИЗЫ -->
  <section class="section" id="prizes" data-sq-block="prizes">
    <div class="wrap trust">
      <div class="reveal">
        <span class="caps">Честные призы</span>
        <h2 class="h2">Фонд внесён заранее — призы не потеряются</h2>
        <p class="lead">Организатор оплачивает призовой фонд до старта турнира. После финала фонд делится по местам, а внутри команды — между игроками.</p>
        <ul class="trust__list">
          <li><ShieldCheck size={20} stroke-width={1.5} />Оплата и выплаты — в защищённом веб-кабинете</li>
          <li><Wallet size={20} stroke-width={1.5} />Выплата через СБП или на карту, налог удерживаем сами</li>
          <li><BarChart3 size={20} stroke-width={1.5} />Статистика игроков из OpenDota, Leetify и Riot API</li>
        </ul>
      </div>
      <div class="podium reveal" aria-label="Распределение призового фонда: 60, 30 и 10 процентов">
        <div class="podium__col podium__col--2"><span class="podium__pct">30%</span><span class="podium__bar"><b>2</b></span></div>
        <div class="podium__col podium__col--1"><span class="podium__pct">60%</span><span class="podium__bar"><b>1</b></span></div>
        <div class="podium__col podium__col--3"><span class="podium__pct">10%</span><span class="podium__bar"><b>3</b></span></div>
      </div>
    </div>
  </section>

  <!-- СКАЧАТЬ -->
  <section class="section section--tight" id="download" data-sq-block="download">
    <div class="wrap dl reveal">
      <div>
        <span class="caps">Android и iOS</span>
        <h2 class="h2">Скоро в магазинах приложений</h2>
        <p class="lead">Мы готовим Squadup к публикации. Нажмите на свою платформу — и мы напишем, когда можно будет скачать.</p>
      </div>
      <StoreButtons place="home" target="#notify" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" data-sq-block="faq">
    <div class="wrap faq-sec">
      <div class="reveal">
        <span class="caps">FAQ</span>
        <h2 class="h2">Частые вопросы</h2>
        <a href="/faq/" class="more">Все вопросы <ArrowRight size={18} stroke-width={1.5} /></a>
      </div>
      <FaqList ids={['release', 'price', 'match', 'prizes']} />
    </div>
  </section>

  <CtaSection place="home" />
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: 72px 0 96px; }
  .hero__in { display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; }
  .hero__badge { margin-bottom: 24px; color: var(--text); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__games { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .hero__visual { position: relative; height: 600px; }
  .hero__phone { position: absolute; width: 270px; }
  .hero__phone--front { left: 4%; top: 20px; z-index: 2; }
  .hero__phone--back { right: 2%; top: 80px; transform: rotate(6deg); opacity: .85; }
  .hero__float {
    position: absolute; z-index: 3; display: flex; flex-direction: column; gap: 4px; padding: 14px 18px;
    border-radius: 16px; background: rgba(21, 26, 35, .9); border: 1px solid var(--border); box-shadow: var(--shadow);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .hero__float b { font-size: 20px; }
  .hero__float--a { right: 26%; top: 0; }
  .hero__float--b { left: 0; bottom: 30px; }
  .hero__float--b b { color: #f0b90b; }
  @media (max-width: 960px) {
    .hero { padding: 40px 0 64px; }
    .hero__in { grid-template-columns: 1fr; }
    .hero__visual { height: 520px; max-width: 520px; margin: 0 auto; width: 100%; }
    .hero__phone { width: 230px; }
  }
  @media (max-width: 520px) {
    .hero__visual { height: 440px; }
    .hero__phone { width: 196px; }
    .hero__phone--front { left: 0; }
    .hero__phone--back { right: 0; }
    .hero__float--a { right: 4%; }
  }

  .feat { display: flex; flex-direction: column; gap: 14px; }
  .feat p { margin: 0; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 28px; color: #b7a6ff; font-weight: 600; }
  .more:hover { color: var(--text); }

  .screens__track {
    display: flex; gap: 28px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin;
    padding: 8px max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))) 24px;
  }
  .screens__item { flex: none; width: 250px; margin: 0; scroll-snap-align: center; }
  .screens__item figcaption { display: flex; flex-direction: column; gap: 2px; margin-top: 18px; text-align: center; font-size: 15px; }
  @media (max-width: 520px) { .screens__item { width: 220px; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: s; }
  .step { padding: 28px 24px; border-radius: var(--r-card); border: 1px solid var(--border); background: linear-gradient(180deg, var(--surface), transparent); }
  .step__n { display: block; font-size: 40px; font-weight: 700; color: transparent; -webkit-text-stroke: 1px rgba(124, 92, 255, .7); margin-bottom: 18px; }
  .step p { margin: 10px 0 0; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  .game {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 220px; padding: 24px;
    border-radius: var(--r-card); overflow: hidden; background: linear-gradient(145deg, var(--from), var(--to));
    border: 1px solid rgba(255, 255, 255, .08); transition: transform .2s, box-shadow .2s;
  }
  .game::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(255,255,255,.04) 0 2px, transparent 2px 14px); }
  .game:hover { transform: translateY(-3px); box-shadow: 0 20px 40px rgba(0, 0, 0, .4); }
  .game > * { position: relative; z-index: 1; }
  .game > .game__code { position: absolute; }
  .game__code {
    position: absolute; top: 20px; right: 20px; padding: 6px 10px; border-radius: 10px;
    background: rgba(0, 0, 0, .35); font-weight: 700; font-size: 14px; color: var(--tone);
  }
  .game__name { font-size: 24px; font-weight: 700; }
  .game__meta { margin-top: 6px; font-size: 14px; color: rgba(255, 255, 255, .75); }

  .trust { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .trust__list { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .trust__list li { display: flex; gap: 12px; align-items: center; color: #c3cad6; }
  .trust__list svg { color: var(--cyan); flex: none; }
  .podium { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; align-items: end; height: 340px; }
  .podium__col { display: flex; flex-direction: column; align-items: center; gap: 12px; height: 100%; justify-content: flex-end; }
  .podium__pct { font-size: 28px; font-weight: 700; }
  .podium__bar { width: 100%; border-radius: 16px 16px 6px 6px; display: grid; place-items: start center; padding-top: 16px; font-size: 26px; }
  .podium__col--1 .podium__bar { height: 78%; background: linear-gradient(180deg, #f0b90b, #8a6806); color: #2a1f03; box-shadow: 0 0 40px rgba(240, 185, 11, .25); }
  .podium__col--2 .podium__bar { height: 52%; background: linear-gradient(180deg, #4a5466, #262c37); }
  .podium__col--3 .podium__bar { height: 34%; background: linear-gradient(180deg, #b7791f, #5c3b0c); }
  @media (max-width: 860px) { .trust { grid-template-columns: 1fr; } .podium { height: 260px; } }

  .dl {
    display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center;
    padding: 40px; border-radius: var(--r-sheet); background: var(--surface); border: 1px solid var(--border);
  }
  .dl .lead { margin-top: 12px; }
  @media (max-width: 860px) { .dl { grid-template-columns: 1fr; padding: 28px 22px; } }

  .faq-sec { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: start; }
  @media (max-width: 860px) { .faq-sec { grid-template-columns: 1fr; gap: 24px; } }
</style>
